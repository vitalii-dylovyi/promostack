{
  "name": "promostack",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/api/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "node packages/engine/bench/bench.ts",
    "dev:api": "node --watch apps/api/src/server.ts",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "node apps/api/src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.24.0"
}
